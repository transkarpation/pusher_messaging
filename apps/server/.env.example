DATABASE_URL=postgres://postgres:postgres@localhost:5433/pusher_messaging
PORT=3000
# Realtime server (apps/realtime-server-phoenix, `pnpm realtime:phoenix`). The secret must match its PHOENIX_SHARED_SECRET.
PHOENIX_SHARED_SECRET=
PHOENIX_URL=http://localhost:4000
PHOENIX_SOCKET_URL=ws://localhost:4000/socket
# Attachment files in an AWS S3 bucket. Leave S3_BUCKET empty to keep them in Postgres (the default).
# Files already stored keep being served from where they are, so no migration is needed.
S3_BUCKET=
S3_REGION=
# Leave both empty to use the default AWS credentials (AWS_* env, ~/.aws profile, instance/task role)
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Prepended to object keys
S3_PREFIX=attachments/
# Push notifications to people who aren't connected.
# Web Push (browsers): a VAPID key pair from `pnpm --filter server push:keys`. Leave empty to turn Web Push off.
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
# A contact for the push services (mailto: or https:)
WEB_PUSH_SUBJECT=mailto:admin@example.com
# Mobile app (Expo push service): only needed when the Expo project requires an access token for sending.
EXPO_ACCESS_TOKEN=
# Rate limits. With REDIS_URL the counters are shared by all API processes (`pnpm redis:up` starts
# Redis on port 6380); without it each process counts in its own memory. RATE_LIMITS=off turns them off.
REDIS_URL=redis://localhost:6380
RATE_LIMITS=
# Behind a reverse proxy: how many proxies are in front (e.g. 1), so client IPs come from X-Forwarded-For.
TRUST_PROXY=
