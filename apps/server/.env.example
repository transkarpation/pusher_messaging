DATABASE_URL=postgres://postgres:postgres@localhost:5433/pusher_messaging
PORT=3000
# Realtime transport: "ws" (the server's own WebSocket endpoint, default), "pusher" or "phoenix"
REALTIME_DRIVER=ws
# Only for REALTIME_DRIVER=pusher
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=eu
# Only for REALTIME_DRIVER=phoenix (apps/realtime-server-phoenix). The secret must match its PHOENIX_SHARED_SECRET.
PHOENIX_SHARED_SECRET=
PHOENIX_URL=http://localhost:4000
PHOENIX_SOCKET_URL=ws://localhost:4000/socket
