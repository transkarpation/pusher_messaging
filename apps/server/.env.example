DATABASE_URL=postgres://postgres:postgres@localhost:5433/pusher_messaging
PORT=3000
# Realtime server (apps/realtime-server-phoenix, `pnpm realtime:phoenix`). The secret must match its PHOENIX_SHARED_SECRET.
PHOENIX_SHARED_SECRET=
PHOENIX_URL=http://localhost:4000
PHOENIX_SOCKET_URL=ws://localhost:4000/socket
# Attachment files in an AWS S3 bucket. Leave S3_BUCKET empty to keep them in Postgres (the default).
# Files already stored keep being served from where they are, so no migration is needed.
S3_BUCKET=
S3_REGION=
# Leave both empty to use the default AWS credentials (AWS_* env, ~/.aws profile, instance/task role)
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Prepended to object keys
S3_PREFIX=attachments/
