{
  "name": "pusher-messaging",
  "private": true,
  "packageManager": "pnpm@12.15.0",
  "scripts": {
    "dev": "pnpm -r --parallel --filter './apps/*' run dev",
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "db:up": "docker compose up -d db",
    "db:generate": "pnpm --filter server db:generate",
    "db:migrate": "pnpm --filter server db:migrate",
    "db:seed": "pnpm --filter server db:seed",
    "db:set-role": "pnpm --filter server db:set-role",
    "db:studio": "pnpm --filter server db:studio",
    "realtime:phoenix": "docker compose up --build realtime-phoenix",
    "redis:up": "docker compose up -d redis"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  }
}
